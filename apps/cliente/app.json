{
  "expo": {
    "owner": "takemeapps-team",
    "name": "Take Me - Cliente",
    "slug": "take-me-cliente",
    "scheme": "take-me-cliente",
    "version": "1.0.2",
    "icon": "./assets/logo.png",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.takeme.cliente",
      "buildNumber": "2",
      "googleServicesFile": "./GoogleService-Info-cliente.plist",
      "supportsTablet": true
    },
    "android": {
      "package": "com.takemeapp.cliente",
      "softwareKeyboardLayoutMode": "pan",
      "googleServicesFile": "./google-services-cliente.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "494a3ce5-d6e4-4cc6-b193-07f045fcd05d"
      }
    },
    "experiments": {
      "autolinkingModuleResolution": true
    },
    "plugins": [
      [
        "@react-native-firebase/app",
        {
          "android": {
            "googleServicesFile": "./google-services-cliente.json"
          },
          "ios": {
            "googleServicesFile": "./GoogleService-Info-cliente.plist"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "backgroundColor": "#000000",
          "imageWidth": 280,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Take Me usa sua localização para definir o ponto de partida e mostrar motoristas próximos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O app precisa acessar suas fotos para alterar a foto de perfil e para anexos no chat.",
          "cameraPermission": "O app usa a câmera para fotos no chat."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "O Take Me usa o microfone para mensagens de voz no chat."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {}
      ],
      "@react-native-community/datetimepicker",
      "expo-apple-authentication"
    ],
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/494a3ce5-d6e4-4cc6-b193-07f045fcd05d"
    }
  }
}
