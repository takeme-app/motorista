{
  "expo": {
    "owner": "takemeapps-team",
    "name": "Take Me - Motorista",
    "newArchEnabled": true,
    "slug": "take-me-motorista",
    "scheme": "take-me-motorista",
    "version": "1.0.2",
    "icon": "./assets/logo.png",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.takeme.motorista",
      "buildNumber": "8",
      "googleServicesFile": "./GoogleService-Info-motorista.plist",
      "supportsTablet": true
    },
    "android": {
      "package": "com.takemeapp.motorista",
      "softwareKeyboardLayoutMode": "pan",
      "googleServicesFile": "./google-services-motorista.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "2646751e-6908-4b9c-9bf8-5cf571e92ecf"
      }
    },
    "plugins": [
      [
        "@react-native-firebase/app",
        {
          "android": {
            "googleServicesFile": "./google-services-motorista.json"
          },
          "ios": {
            "googleServicesFile": "./GoogleService-Info-motorista.plist"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsImpl": "mapbox"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "backgroundColor": "#000000",
          "imageWidth": 280,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Take Me Motorista usa sua localização para exibir sua posição e corridas."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O app precisa acessar suas fotos para enviar documentos e fotos do veículo.",
          "cameraPermission": "O app usa a câmera para fotos no chat e no cadastro."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "O Take Me Motorista usa o microfone para mensagens de voz no chat."
        }
      ],
      "expo-apple-authentication"
    ],
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/2646751e-6908-4b9c-9bf8-5cf571e92ecf"
    }
  }
}
